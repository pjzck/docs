filters:
  and:
    - file.inFolder("knowledge")
    - file.ext == "md"
properties:
  file.name:
    displayName: 文档
  file.folder:
    displayName: 分类
  file.mtime:
    displayName: 更新时间
views:
  - type: table
    name: 知识库
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
